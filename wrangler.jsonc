{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "www",
	"send_metrics": false,
	"compatibility_date": "2026-08-08",
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "ggtn.ch",
			"custom_domain": true
		},
		{
			"pattern": "www.ggtn.ch",
			"custom_domain": true
		}
	],
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"NEXT_PUBLIC_CONVEX_URL": "https://merry-hornet-496.eu-west-1.convex.cloud",
		"NEXT_PUBLIC_CONVEX_SITE_URL": "https://merry-hornet-496.eu-west-1.convex.site",
		"SITE_URL": "https://ggtn.ch"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service must match the Worker name.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "www"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "www-opennext-cache"
		}
	],
	"images": {
		"binding": "IMAGES",
		"remote": true
	}
}
